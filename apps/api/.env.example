# Values here match `docker compose up`, so copying this file is enough to run
# the API on the host with `bun run dev` while the services run in Docker.
# Ports differ from the in-network ones because compose publishes them.

# App
# APP_NAME is the display name used in email copy and as the default sender
# name. APP_SLUG (lowercase letters, digits, hyphens) names cookies and prefixes
# every Redis key, so two apps sharing one Redis or one parent domain never
# collide. docker compose does not read this file: it takes APP_SLUG and
# APP_NAME from the shell or from a .env at the repository root, and uses the
# slug for its project name and the storage bucket.
APP_NAME=Kaboom
APP_SLUG=kaboom
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Paths on APP_URL that emails link to. Set them to match the frontend's
# routing; the defaults below are what the API uses when they are unset.
# APP_VERIFY_EMAIL_PATH=/verify-email
# APP_RESET_PASSWORD_PATH=/reset-password
# APP_CONFIRM_EMAIL_CHANGE_PATH=/confirm-email-change
# APP_SECURITY_PATH=/settings/security

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# Connections in the pool, and how long one statement may run before Postgres
# cancels it. The migrator ignores both so a long migration is never cut short.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Sessions
SESSIONS_REDIS_URL=redis://localhost:6380
SESSIONS_TTL_SECONDS=604800

# Jobs
JOBS_REDIS_URL=redis://localhost:6379

# Cache
CACHE_REDIS_URL=redis://localhost:6381

# Rate limiting
# Counters need persistence and no eviction, so they default to the sessions
# server rather than the cache one. Set this only to move them elsewhere.
# RATE_LIMIT_REDIS_URL=redis://localhost:6380

# Realtime
# Pub/sub stores nothing, so it defaults to the cache server. Set this only to
# move it elsewhere.
# REALTIME_REDIS_URL=redis://localhost:6381

# Mail
SMTP_URL=smtp://localhost:1025
# MAIL_FROM_NAME defaults to APP_NAME.
# MAIL_FROM_NAME=App
MAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Storage
# The same four variables point at RustFS locally and at AWS in production:
# drop STORAGE_S3_ENDPOINT and supply real credentials and a region. Path style
# is assumed whenever an endpoint is set, which is what RustFS needs; set
# STORAGE_S3_FORCE_PATH_STYLE explicitly to override that guess.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=app
STORAGE_S3_ACCESS_KEY_ID=storageadmin
STORAGE_S3_SECRET_ACCESS_KEY=storageadmin
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_FORCE_PATH_STYLE=true

# Proxy
# Leave TRUSTED_PROXY_HEADER unset unless a proxy you control sits in front of
# the API: forwarded headers are attacker-controlled, so an IP is only read from
# one when it is named here. Depth counts the trusted proxies in the chain.
# TRUSTED_PROXY_HEADER=x-forwarded-for
# TRUSTED_PROXY_DEPTH=1

# Metrics
# Set to send request and job metrics to CloudWatch through PutMetricData.
# Credentials and region come from the AWS SDK's usual chain: the ECS task role
# and AWS_REGION in production. The role needs cloudwatch:PutMetricData.
# CLOUDWATCH_METRICS_NAMESPACE=
# CLOUDWATCH_METRICS_FLUSH_SECONDS=60

# Error reporting
# Unset: errors are logged only. Set: 500s, jobs whose last attempt failed and
# failed OAuth callbacks go to Sentry, with no request data attached.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# Captcha
# Two reCAPTCHA registrations: v3 (scored, invisible) and v2 (checkbox), each
# with its own secret. Required in production; unset in development, every
# captcha passes. The site keys belong to the frontend, not here.
# RECAPTCHA_V3_SECRET=
# RECAPTCHA_V2_SECRET=
# CAPTCHA_SCORE_THRESHOLD=0.5

# OAuth
# Each provider is enabled by supplying both of its values; a provider without
# them returns 404. OAUTH_STATE_SECRET (32+ bytes) is required as soon as any
# provider is configured, and OAUTH_REDIRECT_BASE is the API's own origin, used
# to build the callback URL you register with the provider.
# OAUTH_STATE_SECRET=
# OAUTH_REDIRECT_BASE=http://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Logging
# LOG_LEVEL=info
# LOG_PRETTY=true
