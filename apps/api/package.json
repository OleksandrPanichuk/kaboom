{
  "name": "@repo/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "start": "bun dist/main.js",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun seeders/main.ts",
    "db:studio": "bunx --bun drizzle-kit studio",
    "test": "bun test --pass-with-no-tests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "llm:smoke": "bun scripts/llm-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-cloudwatch": "^3.1140.0",
    "@elysia/cors": "^1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "@repo/design": "*",
    "@sentry/bun": "^11.0.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.30",
    "elysia-nazli": "^1.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "1.4.2",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.11.0",
    "pg": "^8.23.0",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
