# Loaded automatically by Bun when NODE_ENV=test, which `bun test` sets itself.
# Only the database is real: every other port resolves to an in-memory adapter,
# so the suite needs Postgres running and nothing else.
#
# The database is created and migrated by tests/helpers/preload.ts on first run.
# It is separate from the development one because the suite truncates between
# tests. Rename it along with APP_SLUG when copying the template: a .env file
# cannot interpolate, so the name is written out here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kaboom_test"

# Deliberately not the defaults, so tests/platform/app-identity.test.ts can
# prove that cookie names, key prefixes and email copy come from here.
APP_NAME=Acme
APP_SLUG=acme

APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:8080
OAUTH_STATE_SECRET=test-only-secret-that-is-long-enough-000
