{
  "name": "@repo/api-codegen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit && tsc -p guard/tsconfig.json --noEmit",
    "generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://codegen:codegen@localhost:5432/codegen}\" NODE_ENV=test bun src/generate-models.ts && DATABASE_URL=\"${DATABASE_URL:-postgresql://codegen:codegen@localhost:5432/codegen}\" NODE_ENV=test bun --cwd ../../apps/api ../../cli-tools/api-codegen/src/generate-client.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test"
  },
  "devDependencies": {
    "@repo/api": "*",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.4.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3"
  }
}
