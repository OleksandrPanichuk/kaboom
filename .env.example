# Read from the repository root, not by the API.
#
# docker compose takes APP_SLUG from here for its project names and the
# storage bucket; the API reads its own copy from apps/api/.env.
APP_NAME=Kaboom
APP_SLUG=kaboom
#
# bun run gen reads DATABASE_ADAPTER to choose which repository adapter a new
# resource gets. postgres generates a Drizzle schema, repository, migration and
# HTTP test; any other value, such as mongo, generates a stub repository to
# implement by hand.
# DATABASE_ADAPTER=postgres
