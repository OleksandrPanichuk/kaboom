{
  "name": "kaboom",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "gen": "bun cli-tools/generator/src/main.ts"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli-tools/*"
  ]
}
